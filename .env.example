NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-secret-here
MONGO_URI=mongodb://localhost:27017/unicorn-care

# Google OAuth — https://console.developers.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:ops@unicorn.care
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Shared secret for the reminder dispatch cron route
CRON_SECRET=your-cron-secret


# Dodo Payments — https://app.dodopayments.com
# Use a dodo_test_... key while developing; test_mode and live_mode have separate product ids.
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_WEBHOOK_SECRET=your-dodo-webhook-signing-secret
DODO_PRODUCT_STANDARD_MONTHLY=pdt_...
DODO_PRODUCT_STANDARD_YEARLY=pdt_...
DODO_PRODUCT_PREMIUM_MONTHLY=pdt_...
DODO_PRODUCT_PREMIUM_YEARLY=pdt_...

# Resend — patient emails
RESEND_API_KEY=
RESEND_FROM=Unicorn Care <onboarding@resend.dev>

# Vercel Blob — admin file uploads (/dashboard/admin).
#
# Vercel creates this variable itself once a Blob store is *connected to the project* under
# Storage. Take it from the store's .env.local tab using the copy button, and paste it — never
# retype it. Both failure modes are confusing enough to be worth naming:
#   "This store does not exist"  — the value was truncated. The token shown in the dashboard table
#                                  is elided; only the copy button gives the whole thing.
#   "Access denied…valid token"  — the value is the right shape but one character is wrong. The
#                                  secret mixes 0/O and 1/l, so a hand-copied token looks correct
#                                  and fails. `vercel blob list --rw-token <token>` tells you in
#                                  one command whether the credential itself is good.
#
# Without it, uploads are refused with BLOB_NOT_CONFIGURED and the rest of the console still works.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-store-id_your-secret
